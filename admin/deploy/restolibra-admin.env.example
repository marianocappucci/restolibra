# Variables de entorno del backoffice. Copiar a /etc/restolibra-admin.env en el
# servidor (root:root, chmod 600) y completar con valores reales. NO commitear el
# archivo real con secretos.

# Clave para firmar la cookie de sesión (cualquier string largo y aleatorio).
SECRET_KEY=cambiar-por-un-secreto-largo-aleatorio

# Credenciales del único superadmin del panel.
ADMIN_PANEL_USER=superadmin
ADMIN_PANEL_PASSWORD=cambiar-por-una-contraseña-fuerte
