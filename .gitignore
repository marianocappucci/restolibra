/clientes/

# Base de datos y config de entorno de desarrollo
dev-data/

# Archivos de journal WAL de SQLite (temporales, no deben versionarse)
*.db-shm
*.db-wal

# Config privada de Nginx Proxy Manager (credenciales)
scripts/.npm_config.json

# Scripts de infraestructura local (no van a producción)
scripts/create_dev_proxy.py

# Frontend (React SPA, ver wiki/entities/restolibra.md): node_modules y el
# build no se versionan -- el build de produccion lo genera el Dockerfile
# (stage node:20-slim).
frontend/node_modules/
frontend/dist/

# Artefactos de cobertura (agregado 2026-07-31, junto con el paso de coverage
# en el CI). Son salida de la herramienta, se regeneran en cada corrida y el
# .coverage es un binario de ~100-250 KB: no van al repo.
.coverage
.coverage.*
coverage.xml
htmlcov/
coverage/
frontend/coverage/

# Reporte JUnit que emite el paso de tests del CI para su gate.
frontend/vitest.xml
